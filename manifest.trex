<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.boonthavorn.orderreserveaging" extension-version="0.1.0">
    <default-locale>th_TH</default-locale>
    <name>Order Reserve Aging Dashboard</name>
    <description>
      Dashboard รายงาน Order Reserve Aging ดึงข้อมูลจาก BigQuery
      (boonthavorn-data-analytic.tableau.ds_vdo_order_reserve_aging) ผ่าน Google OAuth
    </description>
    <author name="Chonnikan Saw" email="chonnikan.saw@boonthavorn.com" organization="Boonthavorn" website="https://www.boonthavorn.com"/>
    <min-api-version>1.9</min-api-version>
    <source-location>
      <!--
        ตอน dev ให้รัน local static server แล้วชี้ url นี้ไปที่ไฟล์ reserve_aging.html เช่น
        python -m http.server 8765   (รันในโฟลเดอร์ order-reserve-aging)
        แล้วเปิด http://localhost:8765/reserve_aging.html ทดสอบใน browser ก่อน จากนั้นค่อย add extension นี้ใน Tableau

        พอ deploy ขึ้น GitHub Pages แล้ว ให้เปลี่ยน url ด้านล่างเป็น
        https://<github-username>.github.io/<repo-name>/reserve_aging.html
      -->
      <url>http://localhost:8765/reserve_aging.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=</icon>
  </dashboard-extension>
</manifest>
